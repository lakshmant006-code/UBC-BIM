{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/", "destination": "/ui_kits/website/index.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/ui_kits/website/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
